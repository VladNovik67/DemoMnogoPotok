insert into orders (name,city)
values ('Ivan', 'Moscow'),
        ('Mary', 'Spb'),
        ('John', 'New-York'),
        ('Ivan', 'Moscow');
        
select name,city
from customers
INNER JOIN orders
    ON customers.id=orders.customer_id;
    
select 
