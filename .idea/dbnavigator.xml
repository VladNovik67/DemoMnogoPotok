from customers;

create table orders 
(
    id INT AUTO_INCREMENT PRIMARY KEY,
    customer_id INT,
    order_amount INT, 
    FOREIGN KEY  (customer_id)  REFERENCES customers (id) 
);

insert into orders(customer_id, order_amount)
values  ((select id from customers where name = 'Ivan' LIMIT 1), 100),
        ((select id from customers where name = 'Ivan' LIMIT 1), 200),
        ((select id from customers where name = 'Mary'), 500),
